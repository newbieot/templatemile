{
  "manifest_version": 3,
  "name": "Mile CN23 Helper",
  "version": "0.2.6",
  "description": "Upload Excel dokumen luar Batam dan proses antrean CN23 otomatis.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://expos.mile.app/*"
  ],
  "action": {
    "default_title": "Upload Excel + Start CN23"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://expos.mile.app/*"
      ],
      "js": [
        "vendor/xlsx.full.min.js",
        "queue.js",
        "ui.js",
        "form.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
